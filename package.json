{
  "name": "spiegelmond",
  "private": true,
  "version": "0.6.0",
  "releaseDate": "2026-11-27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "npm run lint:ts && npm run lint:rust",
    "lint:ts": "tsc --noEmit",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:core": "cargo fmt --all --check && cargo clippy -p iv-core --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "i18next": "^27.1.3",
    "lucide-react": "^1.74.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
