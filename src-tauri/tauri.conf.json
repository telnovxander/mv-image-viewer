{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spiegelmond",
  "mainBinaryName": "iv",
  "version": "../package.json",
  "identifier": "com.moonshinevibecoder.spiegelmond",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spiegelmond",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost ivimg: http://ivimg.localhost ivthumb: http://ivthumb.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Moonshine Vibecoder",
    "copyright": "Moonshine Vibecoder",
    "shortDescription": "Spiegelmond, an image viewer",
    "longDescription": "Spiegelmond is a fast image viewer of the Moonshine Vibecoder family.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian", "German"],
        "displayLanguageSelector": false
      }
    }
  }
}
